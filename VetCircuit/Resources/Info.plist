<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>VetCircuit</string>
	<key>CFBundleShortVersionString</key>
	<string>1.1</string>
	<key>CFBundleVersion</key>
	<string>2</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>VetCircuit uses your camera to let you attach photos of your pet to chat with your vet.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>VetCircuit uses your photo library so you can share photos of your pet with your vet.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>VetCircuit uses your location to show nearby vet circuits and let you track your vet's arrival.</string>
	<key>NSUserTrackingUsageDescription</key>
	<string>VetCircuit does not track you across other apps or websites.</string>
	<!-- SUPABASE_URL / SUPABASE_ANON_KEY are injected via an .xcconfig + build
	     setting substitution, never committed as literal secrets. -->
	<key>SUPABASE_URL</key>
	<string>$(SUPABASE_URL)</string>
	<key>SUPABASE_ANON_KEY</key>
	<string>$(SUPABASE_ANON_KEY)</string>
</dict>
</plist>
